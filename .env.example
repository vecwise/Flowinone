# Resource Library (all paths may be absolute)
FLOWINONE_DATA_DIR=./data
FLOWINONE_RESOURCE_DB_PATH=./data/flowinone.sqlite3
FLOWINONE_RESOURCE_CONTENT_DIR=./data/content
FLOWINONE_RESOURCE_WORKER=1

# Optional OpenAI-compatible provider (LM Studio example)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=
FLOWINONE_USER_CONTEXT=Flowinone、AI agent、個人知識庫、軟體專案與創作靈感

# Bounded network fetching
HTTP_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES=20000000
